{
  "id": "copilot",
  "displayName": "GitHub Copilot",
  "deployMode": "hook",
  "detection": {
    "paths": ["~/.copilot"],
    "commands": []
  },
  "hook": {
    "settingsPath": "~/.copilot/hooks/loongsuite-pilot.json",
    "events": ["SessionStart", "UserPromptSubmit", "Stop"],
    "hookCommand": "$PILOT_DATA/hooks/copilot-loongsuite-pilot-hook.sh",
    "format": "flat",
    "matcher": "",
    "eventSubcommand": "kebab-case"
  },
  "input": {
    "type": "session-file-polling"
  }
}
