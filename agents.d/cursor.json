{
  "id": "cursor",
  "displayName": "Cursor",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "~/.cursor"
    ],
    "commands": []
  },
  "hook": {
    "settingsPath": "~/.cursor/hooks.json",
    "events": [
      "stop",
      "preToolUse",
      "postToolUse",
      "postToolUseFailure",
      "beforeSubmitPrompt",
      "preCompact",
      "sessionStart",
      "sessionEnd",
      "subagentStart",
      "subagentStop",
      "afterAgentResponse",
      "afterAgentThought"
    ],
    "hookCommand": "$PILOT_DATA/hooks/cursor-loongsuite-pilot-hook.sh",
    "format": "flat"
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/cursor/history"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "cursor-hook",
        "role": "primary"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "cursor.managed-hook-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "cursor.managed-hook-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "cursor.managed-hook-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "cursor.managed-hook-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
