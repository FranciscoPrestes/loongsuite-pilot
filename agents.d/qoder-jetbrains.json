{
  "id": "qoder-jetbrains",
  "displayName": "Qoder for JetBrains",
  "deployMode": "detection-only",
  "detection": {
    "paths": [
      "~/Library/Application Support/JetBrains/IntelliJIdea*/plugins/qoder-jetbrains",
      "~/Library/Application Support/JetBrains/IdeaIC*/plugins/qoder-jetbrains",
      "~/Library/Application Support/JetBrains/PyCharm*/plugins/qoder-jetbrains",
      "~/Library/Application Support/JetBrains/WebStorm*/plugins/qoder-jetbrains",
      "~/Library/Application Support/JetBrains/GoLand*/plugins/qoder-jetbrains",
      "~/.config/JetBrains/IntelliJIdea*/plugins/qoder-jetbrains",
      "~/.config/JetBrains/IdeaIC*/plugins/qoder-jetbrains",
      "~/.config/JetBrains/PyCharm*/plugins/qoder-jetbrains",
      "~/.config/JetBrains/WebStorm*/plugins/qoder-jetbrains",
      "~/.config/JetBrains/GoLand*/plugins/qoder-jetbrains"
    ],
    "commands": []
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "shared-local-source"
    ],
    "adapters": [
      {
        "id": "qoder-trace",
        "role": "shared"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "qoder.shared-native-session-unresolved",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "qoder.shared-native-session-unresolved",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "qoder.shared-native-session-unresolved",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "qoder.shared-native-session-unresolved",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "unavailable",
      "tools": "unavailable",
      "results": "unavailable",
      "tokens": "unavailable",
      "subagents": "unavailable"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Detection only; shared Qoder source identity must be resolved before attribution",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
