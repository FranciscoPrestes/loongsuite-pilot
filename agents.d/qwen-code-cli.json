{
  "id": "qwen-code-cli",
  "displayName": "Qwen Code CLI",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "~/.qwen"
    ],
    "commands": [
      "qwen"
    ]
  },
  "hook": {
    "settingsPath": "~/.qwen/settings.json",
    "settingsSyntax": "jsonc",
    "events": [
      "Stop",
      "SubagentStart",
      "SubagentStop"
    ],
    "hookCommand": "$PILOT_DATA/hooks/qwen-code-cli-loongsuite-pilot-hook.sh",
    "format": "nested",
    "matcher": "*",
    "eventSubcommand": "kebab-case",
    "replaceHookCommands": [
      "otel-qwen-hook",
      ".cache/opentelemetry.instrumentation.qwen"
    ]
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/qwen-code-cli"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "qwen-code-cli-log",
        "role": "primary"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "qwen-code-cli.managed-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "qwen-code-cli.managed-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "qwen-code-cli.managed-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "qwen-code-cli.managed-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
