{
  "id": "qoder-work",
  "displayName": "QoderWork",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "~/.qoderwork"
    ],
    "commands": []
  },
  "hook": {
    "settingsPath": "~/.qoderwork/settings.json",
    "events": [
      "Stop"
    ],
    "hookCommand": "$PILOT_DATA/hooks/qoderwork-loongsuite-pilot-hook.sh",
    "format": "nested",
    "matcher": "*",
    "winShell": "powershell",
    "replaceHookCommands": [
      "$PILOT_DATA/hooks/qoder-loongsuite-pilot-hook.sh qoder-work"
    ]
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/qoder-work/history"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "qoder-work-trace",
        "role": "primary"
      },
      {
        "id": "qoder-work-hook",
        "role": "fallback",
        "whenPrimaryDisabled": "qoder-work-trace"
      },
      {
        "id": "qoder-work-log",
        "role": "fallback",
        "whenPrimaryDisabled": "qoder-work-trace"
      },
      {
        "id": "qoder-work-sqlite",
        "role": "fallback",
        "whenPrimaryDisabled": "qoder-work-trace"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "qoder-work.trace.sdk-log-and-sqlite",
        "secondary": [
          "qoder-work.hook",
          "qoder-work.sqlite"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "qoder-work.trace.sdk-log-and-sqlite",
        "secondary": [
          "qoder-work.hook",
          "qoder-work.sqlite"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "qoder-work.trace.sdk-log-and-sqlite",
        "secondary": [
          "qoder-work.hook",
          "qoder-work.sqlite"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "qoder-work.trace.sdk-log-and-sqlite",
        "secondary": [
          "qoder-work.hook",
          "qoder-work.sqlite"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
