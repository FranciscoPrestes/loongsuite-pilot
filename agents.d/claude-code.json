{
  "id": "claude-code",
  "displayName": "Claude Code",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "~/.claude"
    ],
    "commands": [
      "claude"
    ]
  },
  "hook": {
    "settingsPath": "~/.claude/settings.json",
    "events": [
      "PreToolUse",
      "Stop",
      "StopFailure",
      "SubagentStart",
      "SubagentStop"
    ],
    "hookCommand": "$PILOT_DATA/hooks/claude-code-loongsuite-pilot-hook.sh",
    "format": "nested",
    "matcher": "*",
    "eventMatchers": {
      "PreToolUse": "Bash"
    },
    "eventSubcommand": "kebab-case",
    "replaceHookCommands": [
      "otel-claude-hook",
      ".cache/opentelemetry.instrumentation.claude"
    ]
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/claude-code"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "claude-code-log",
        "role": "primary"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "claude-code.managed-transcript-jsonl",
        "secondary": [
          "claude-code.native-hook-id",
          "claude-code.fetch-intercept"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "claude-code.managed-transcript-jsonl",
        "secondary": [
          "claude-code.native-hook-id",
          "claude-code.fetch-intercept"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "claude-code.managed-transcript-jsonl",
        "secondary": [
          "claude-code.native-hook-id",
          "claude-code.fetch-intercept"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "claude-code.managed-transcript-jsonl",
        "secondary": [
          "claude-code.native-hook-id",
          "claude-code.fetch-intercept"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Synthetic Task completion is not runner approval",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
