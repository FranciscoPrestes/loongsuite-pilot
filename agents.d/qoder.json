{
  "id": "qoder",
  "displayName": "Qoder",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "~/.qoder"
    ],
    "commands": [
      "qoder"
    ]
  },
  "hook": {
    "settingsPath": "~/.qoder/settings.json",
    "events": [
      "Stop"
    ],
    "hookCommand": "$PILOT_DATA/hooks/qoder-loongsuite-pilot-hook.sh",
    "format": "nested",
    "matcher": "*",
    "winShell": "powershell",
    "replaceHookCommands": [
      "$PILOT_DATA/hooks/qoder-loongsuite-pilot-hook.sh qoder-cli",
      "$PILOT_DATA/hooks/qoder-loongsuite-pilot-hook.sh qoder"
    ],
    "interceptor": {
      "events": [
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse"
      ],
      "hookCommand": "$PILOT_DATA/hooks/interceptor-hook.sh",
      "matcher": "*",
      "timeout": {
        "UserPromptSubmit": 15,
        "PreToolUse": 10,
        "PostToolUse": 10
      },
      "insert": "head"
    }
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/qoder/history"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "qoder-trace",
        "role": "primary"
      },
      {
        "id": "qoder",
        "role": "retired",
        "reason": "Superseded by primary native transcript/trace; dual-stream collection is not validated"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "qoder.managed-hook-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "qoder.managed-hook-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "qoder.managed-hook-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "qoder.trace.native-variant-token-authority",
        "secondary": [
          "qoder.native-segments-missing-token-fallback",
          "qoder.ide-sqlite"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta",
        "variantPrimaries": [
          {
            "variant": "cli",
            "primary": "qoder.cli-token-intercept",
            "secondary": [
              "qoder.native-segments-missing-data-fallback"
            ]
          },
          {
            "variant": "ide",
            "primary": "qoder.ide-sqlite",
            "secondary": []
          }
        ]
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "CLI intercept tokens are primary; native segments only fill missing tokens",
      "Legacy qoder IDE adapter is retired",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
