{
  "id": "workbuddy",
  "displayName": "WorkBuddy",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "~/.workbuddy"
    ],
    "commands": []
  },
  "hook": {
    "settingsPath": "~/.workbuddy/settings.json",
    "events": [
      "SessionStart",
      "UserPromptSubmit",
      "PreToolUse",
      "PostToolUse",
      "Stop"
    ],
    "hookCommand": "$PILOT_DATA/hooks/workbuddy-loongsuite-pilot-hook.sh",
    "format": "nested",
    "eventSubcommand": "kebab-case",
    "eventMatchers": {
      "PreToolUse": ".*",
      "PostToolUse": ".*"
    }
  },
  "input": {
    "type": "workbuddy-transcript",
    "eventDir": "$PILOT_DATA/state/workbuddy/hook-events"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "workbuddy",
        "role": "primary"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "workbuddy.native-transcript",
        "secondary": [
          "workbuddy.hook-wakeup"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "workbuddy.native-transcript",
        "secondary": [
          "workbuddy.hook-wakeup"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "workbuddy.native-transcript",
        "secondary": [
          "workbuddy.hook-wakeup"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "workbuddy.native-transcript",
        "secondary": [
          "workbuddy.hook-wakeup"
        ],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
