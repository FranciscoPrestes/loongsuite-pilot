{
  "id": "kiro-cli",
  "displayName": "Kiro CLI",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "~/.kiro",
      "~/.local/share/kiro-cli"
    ],
    "commands": [
      "kiro-cli"
    ]
  },
  "runtime": {
    "nodeSqlite": "required-for-transcript",
    "nodeSqliteSince": "22.5.0",
    "fallback": "无 node:sqlite 时 hook fail-open：transcript 双源中的 sqlite 主干不可用，仅 hook 事件链路（postToolUse tool_response + stop 信号）可采集；STEP/LLM span 与 token/credit 对齐依赖 transcript，故无 builtin 时不含 LLM 步。"
  },
  "hook": {
    "settingsPath": "~/.kiro/agents/pilot-kiro.json",
    "events": [
      "userPromptSubmit",
      "preToolUse",
      "postToolUse",
      "stop"
    ],
    "hookCommand": "$PILOT_DATA/hooks/kiro-cli-loongsuite-pilot-hook.sh",
    "format": "flat",
    "matcher": "*",
    "eventSubcommand": "as-is",
    "kiroAgent": {
      "name": "pilot-kiro",
      "tools": [
        "read",
        "write",
        "shell",
        "grep",
        "glob",
        "report",
        "thinking",
        "todo"
      ]
    }
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/kiro-cli"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "kiro-cli-log",
        "role": "primary"
      },
      {
        "id": "kiro-cli-session",
        "role": "supplement"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "kiro-cli.managed-sqlite-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "kiro-cli.managed-sqlite-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "kiro-cli.managed-sqlite-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "kiro-cli.managed-sqlite-transcript-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Node sqlite >=22.5 required for richer transcript; hook-only fallback has incomplete timing and tokens",
      "Delayed session scheduler produces canonical JSONL; not a second evidence count",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
