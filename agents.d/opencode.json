{
  "id": "opencode",
  "displayName": "OpenCode",
  "deployMode": "plugin-inject",
  "detection": {
    "paths": [
      "~/.config/opencode"
    ],
    "commands": [
      "opencode"
    ]
  },
  "pluginInject": {
    "createIfMissing": true,
    "configPaths": [
      "~/.config/opencode/opencode.jsonc",
      "~/.config/opencode/opencode.json",
      "~/.config/opencode/config.json"
    ],
    "pluginSpec": "file://$PILOT_DATA/plugins/opencode",
    "pluginId": "loongsuite-pilot-opencode",
    "replaceSpecs": [
      "file://$PILOT_DATA/plugins/opencode/plugin.mjs",
      "loongsuite-pilot-opencode",
      "loongsuite-pilot-opencode-smoke",
      "plugins/opencode/plugin.mjs"
    ]
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/opencode"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-extension-jsonl"
    ],
    "adapters": [
      {
        "id": "opencode-log",
        "role": "primary"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "opencode.local-plugin-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "opencode.local-plugin-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "opencode.local-plugin-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "opencode.local-plugin-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
