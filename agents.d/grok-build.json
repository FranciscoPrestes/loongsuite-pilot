{
  "id": "grok-build",
  "displayName": "Grok Build",
  "deployMode": "hook",
  "detection": {
    "paths": [
      "$GROK_HOME"
    ],
    "commands": []
  },
  "hook": {
    "settingsPath": "$GROK_HOME/hooks/loongsuite-pilot.json",
    "events": [
      "stop",
      "stop_failure",
      "user_prompt_submit",
      "session_end"
    ],
    "hookCommand": "$PILOT_DATA/hooks/grok-build-loongsuite-pilot-hook.sh",
    "format": "nested",
    "matcher": "",
    "eventSubcommand": "as-is"
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/grok-build"
  },
  "analytics": {
    "version": 1,
    "lifecycle": "supported",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "versionRange": null,
    "mechanisms": [
      "local-hook-transcript-jsonl"
    ],
    "adapters": [
      {
        "id": "grok-build-log",
        "role": "primary"
      }
    ],
    "sourceRules": [
      {
        "eventClass": "message",
        "primary": "grok-build.managed-transcript-fusion-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_call",
        "primary": "grok-build.managed-transcript-fusion-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "tool_result",
        "primary": "grok-build.managed-transcript-fusion-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes"
      },
      {
        "eventClass": "llm_usage",
        "primary": "grok-build.managed-transcript-fusion-jsonl",
        "secondary": [],
        "equivalence": "native-id-or-validated-rule",
        "unresolvedSecondary": "exclude-additive-volumes",
        "usageSemantics": "delta"
      }
    ],
    "capabilities": {
      "messages": "conditional",
      "tools": "conditional",
      "results": "conditional",
      "tokens": "conditional",
      "subagents": "conditional"
    },
    "gaps": [
      "Live execution validation pending",
      "Availability depends on native version, platform and fields",
      "Name/order matches remain unresolved unless validated by adapter-specific evidence",
      "Subagent relationships require native parent identity; source resemblance is unresolved"
    ]
  }
}
